<UserControl x:Class="GuDisk.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

      <!-- ============ 参数 ============ -->
      <Border Style="{DynamicResource ModuleCard}" Margin="0,0,0,12">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="模式" FontSize="11" Foreground="{DynamicResource Brush.Text3}"/>
              <ComboBox x:Name="ModeBox" Width="180" Height="30" Margin="0,4,0,0">
                <ComboBoxItem Content="测试文件（安全，不碰数据）" IsSelected="True"/>
                <ComboBoxItem Content="裸盘只读（需管理员）"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="扫描范围" FontSize="11" Foreground="{DynamicResource Brush.Text3}"/>
              <ComboBox x:Name="SizeBox" Width="240" Height="30" Margin="0,4,0,0"
                        SelectionChanged="OnSizeChanged">
                <ComboBoxItem Content="快速抽检（1 GB）"/>
                <ComboBoxItem Content="10 GB"/>
                <ComboBoxItem Content="100 GB"/>
                <ComboBoxItem Content="500 GB"/>
                <ComboBoxItem Content="1 TB"/>
                <ComboBoxItem Content="2 TB"/>
                <ComboBoxItem Content="4 TB"/>
                <ComboBoxItem Content="8 TB"/>
                <ComboBoxItem Content="一半空闲空间"/>
                <ComboBoxItem Content="全部空闲空间" IsSelected="True"/>
                <ComboBoxItem Content="整盘（仅裸盘模式）"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="超时阈值（毫秒）" FontSize="11" Foreground="{DynamicResource Brush.Text3}"/>
              <TextBox x:Name="TimeoutBox" Width="100" Height="30" Margin="0,4,0,0" Text="3000"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="自定义路径（留空 = 盘符根目录）" FontSize="11"
                         Foreground="{DynamicResource Brush.Text3}"/>
              <TextBox x:Name="PathBox" Width="260" Height="30" Margin="0,4,0,0"/>
            </StackPanel>
          </WrapPanel>

          <CheckBox x:Name="SleepGuardBox" Content="检测时阻止系统睡眠" IsChecked="True" Margin="0,6,0,0"
                    Foreground="{DynamicResource Brush.Text2}"
                    ToolTip="机械盘全盘扫描要几小时，中途休眠会让盘停转，后续每一块都要等唤醒 → 结果全是橙红。只阻止系统睡眠，屏幕仍可关闭。"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RunBtn" Style="{DynamicResource PrimaryButton}" Content="开始扫描" Click="OnRun"/>
            <Button x:Name="StopBtn" Style="{DynamicResource QuietButton}" Content="停止" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnStop"/>
            <Button x:Name="ResetBtn" Style="{DynamicResource QuietButton}" Content="复位" Margin="8,0,0,0"
                    Click="OnReset" ToolTip="清掉上一次的图和计数"/>
            <Button x:Name="CsvBtn" Style="{DynamicResource QuietButton}" Content="导出 CSV" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnExport"/>
          </StackPanel>

          <TextBlock x:Name="SpaceText" Margin="0,10,0,0" FontSize="11.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text2}"/>
          <TextBlock x:Name="TargetText" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text3}"/>
        </StackPanel>
      </Border>

      <!-- ============ 进度 + 摘要 ============ -->
      <Border Style="{DynamicResource ModuleCard}" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <TextBlock x:Name="PhaseText" FontSize="12" Foreground="{DynamicResource Brush.Text1}"/>
            <TextBlock x:Name="EtaText" FontSize="11.5" HorizontalAlignment="Right"
                       Foreground="{DynamicResource Brush.Text3}"/>
          </Grid>
          <ProgressBar x:Name="Bar" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100"/>

          <!-- 三块大数字，照 HDTune 右侧那块面板 -->
          <UniformGrid Columns="3" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{DynamicResource MicroLabel}" Text="最低"/>
              <TextBlock x:Name="MinText" FontFamily="{DynamicResource Font.Mono}" FontSize="20"
                         FontWeight="Bold" Foreground="{DynamicResource Brush.Text1}" Text="—"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{DynamicResource MicroLabel}" Text="平均"/>
              <TextBlock x:Name="AvgText" FontFamily="{DynamicResource Font.Mono}" FontSize="20"
                         FontWeight="Bold" Foreground="{DynamicResource Brush.Lime}" Text="—"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{DynamicResource MicroLabel}" Text="最高"/>
              <TextBlock x:Name="MaxText" FontFamily="{DynamicResource Font.Mono}" FontSize="20"
                         FontWeight="Bold" Foreground="{DynamicResource Brush.Text1}" Text="—"/>
            </StackPanel>
          </UniformGrid>

          <TextBlock x:Name="ConclusionText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text3}" Text="选择范围后点「开始扫描」。"/>
        </StackPanel>
      </Border>

      <!-- ============ 地图 + 分级计数 ============ -->
      <Border Style="{DynamicResource ModuleCard}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Style="{DynamicResource MicroLabel}" Text="坏块热力地图"/>
            <ItemsControl x:Name="HeatMap" Margin="0,8,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="64" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="12" Height="12" Margin="0.5" CornerRadius="2"
                          Background="{Binding Brush}" ToolTip="{Binding Tip}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="MapInfo" Style="{DynamicResource MicroLabel}" Margin="0,8,0,0"
                       Text="尚未扫描"/>
          </StackPanel>

          <!-- 七档图例 + 实时计数（参考软件右侧那一列） -->
          <StackPanel Grid.Column="1" MinWidth="190">
            <TextBlock Style="{DynamicResource MicroLabel}" Text="响应等级（按每块耗时）"/>
            <ItemsControl x:Name="LegendList" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="14"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2"
                            VerticalAlignment="Center" Background="{Binding Color}"/>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                      <TextBlock Text="{Binding Name}" FontSize="12.5"
                                 Foreground="{DynamicResource Brush.Text2}"/>
                      <TextBlock Text="{Binding Range}" FontSize="10"
                                 Foreground="{DynamicResource Brush.Text3}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="14" FontWeight="Bold"
                               FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center"
                               Foreground="{Binding Color}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ 问题块明细 ============ -->
      <Border Style="{DynamicResource ModuleCard}">
        <StackPanel>
          <TextBlock x:Name="ProblemHeader" Style="{DynamicResource MicroLabel}" Text="问题块（尚未扫描）"/>
          <ListView x:Name="ProblemList" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                    MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="偏移" Width="130" DisplayMemberBinding="{Binding OffsetText}"/>
                <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding ClassText}"/>
                <GridViewColumn Header="速度" Width="110" DisplayMemberBinding="{Binding SpeedText}"/>
                <GridViewColumn Header="错误码" Width="80" DisplayMemberBinding="{Binding ErrorText}"/>
                <GridViewColumn Header="解释" Width="380" DisplayMemberBinding="{Binding Explanation}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
