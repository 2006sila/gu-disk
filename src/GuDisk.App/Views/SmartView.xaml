<UserControl x:Class="GuDisk.App.Views.SmartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GuDisk.App.Converters">
  <UserControl.Resources>
    <conv:AttrNameConverter x:Key="AttrName"/>
    <conv:AttrValueConverter x:Key="AttrValue"/>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{DynamicResource ModuleCard}" Margin="0,0,6,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <TextBlock Style="{DynamicResource MicroLabel}" Text="S.M.A.R.T. 属性明细"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{DynamicResource QuietButton}" Content="复制表格" Height="26" Padding="12,0"
                    Click="OnCopyTable"/>
            <Button Style="{DynamicResource QuietButton}" Content="保存为图片" Height="26" Padding="12,0"
                    Margin="8,0,0,0" Click="OnSaveImage"/>
            <TextBlock x:Name="CountText" Style="{DynamicResource MicroLabel}" VerticalAlignment="Center"
                       Margin="14,0,0,0"/>
          </StackPanel>
        </Grid>
        <ListView x:Name="AttrList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                  Foreground="{DynamicResource Brush.Text1}" SelectionChanged="OnSelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="ID" Width="40">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Id, StringFormat=X2}" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Text3}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="属性名称" Width="180">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Converter={StaticResource AttrName}}" FontWeight="SemiBold"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="当前" Width="52">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding CurrentText}" HorizontalAlignment="Right"
                                           FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Text2}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="最差" Width="52">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding WorstText}" HorizontalAlignment="Right"
                                           FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Text3}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="临界" Width="52">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding ThresholdText}" HorizontalAlignment="Right"
                                           FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Text3}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="原始值（十进制）" Width="210">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Converter={StaticResource AttrValue}}" FontFamily="{DynamicResource Font.Mono}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="原始值（十六进制）" Width="120">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding RawHex}" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Text3}" FontSize="11"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="状态" Width="60">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Status}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>
    </Border>

    <Border Grid.Column="1" Style="{DynamicResource ModuleCard}" Margin="6,0,0,0">
      <StackPanel x:Name="DetailPanel">
        <TextBlock Style="{DynamicResource MicroLabel}" Text="属性解读"/>
        <TextBlock x:Name="DetailHint" Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text3}"
                   Text="点击左侧任意一行属性查看解读。"/>
        <StackPanel x:Name="DetailBody" Visibility="Collapsed">
          <TextBlock x:Name="DetailName" Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text1}"/>
          <TextBlock x:Name="DetailId" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                     Foreground="{DynamicResource Brush.Text3}" Margin="0,2,0,0"/>
          <TextBlock x:Name="DetailRaw" Margin="0,12,0,0" FontFamily="{DynamicResource Font.Mono}"
                     FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Lime}"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="DetailStatus" Margin="0,10,0,0" FontSize="12.5"
                     Foreground="{DynamicResource Brush.Text2}"/>
          <StackPanel Margin="0,14,0,0">
            <TextBlock Style="{DynamicResource MicroLabel}" Text="同一个数的两种写法"/>
            <TextBlock x:Name="DetailValues" Margin="0,6,0,0" FontFamily="{DynamicResource Font.Mono}"
                       FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
