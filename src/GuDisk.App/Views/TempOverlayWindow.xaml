<Window x:Class="GuDisk.App.Views.TempOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" Title="Gu-disk 温度" Icon="pack://application:,,,/Assets/gudisk.ico">
  <Border x:Name="Shell" CornerRadius="10" Padding="12,8" Margin="8"
          Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1"
          MouseLeftButtonDown="OnDrag" MouseRightButtonUp="OnMenu">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
    </Border.Effect>
    <StackPanel MinWidth="150">
      <!-- 单盘：大号温度 -->
      <StackPanel x:Name="SinglePanel">
        <TextBlock x:Name="TempText" FontFamily="{DynamicResource Font.Mono}" FontSize="24"
                   FontWeight="Bold" Foreground="{DynamicResource Brush.Lime}" Text="-- ℃"/>
        <TextBlock x:Name="ModelText" FontSize="10" MaxWidth="160" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.Text3}" Margin="0,2,0,0"/>
      </StackPanel>

      <!-- 多盘：紧凑列表 -->
      <ItemsControl x:Name="MultiList" Visibility="Collapsed">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" MaxWidth="130"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Foreground="{Binding Brush}" ToolTip="{Binding FullName}"/>
              <TextBlock Grid.Column="1" Text="{Binding Temp}" Margin="10,0,0,0" FontSize="13"
                         FontFamily="{DynamicResource Font.Mono}" FontWeight="SemiBold"
                         Foreground="{Binding Brush}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
