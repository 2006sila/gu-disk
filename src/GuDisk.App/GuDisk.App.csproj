<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- exe 图标；同时作为 WPF 资源嵌入，供窗口与托盘在运行时读取 -->
    <ApplicationIcon>Assets\gudisk.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Gu-disk</AssemblyName>
    <RootNamespace>GuDisk.App</RootNamespace>
    <!-- M1 起改为 app.requireadmin.manifest（requireAdministrator）；M0 无底层访问，先用 asInvoker 便于迭代 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWindowsForms 会注入 System.Windows.Forms / System.Drawing 的全局 using，
         与 WPF 的 UserControl / Application / Color / Point 全部撞名 —— 这里摘掉，托盘文件里局部引入。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GuDisk.Core\GuDisk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\gudisk.ico" />
  </ItemGroup>
</Project>
