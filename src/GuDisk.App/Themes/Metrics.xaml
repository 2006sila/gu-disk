<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <sys:Double x:Key="Size.TopBar">56</sys:Double>
  <sys:Double x:Key="Size.Tabs">44</sys:Double>
  <sys:Double x:Key="Size.Dock">58</sys:Double>

  <CornerRadius x:Key="Corner.R">8</CornerRadius>
  <CornerRadius x:Key="Corner.RSm">5</CornerRadius>

  <sys:Double x:Key="Font.Micro">10.5</sys:Double>
  <sys:Double x:Key="Font.Body">13</sys:Double>
  <sys:Double x:Key="Font.Small">11.5</sys:Double>
</ResourceDictionary>
