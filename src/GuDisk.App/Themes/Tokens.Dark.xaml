<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 深色令牌 · 见 docs/外观规范.md 第 2 节。中性炭黑，无蓝调 -->
  <SolidColorBrush x:Key="Brush.Bg"        Color="#FF0B0C0E"/>
  <SolidColorBrush x:Key="Brush.Surface"   Color="#FF121417"/>
  <SolidColorBrush x:Key="Brush.Surface2"  Color="#FF171A1E"/>
  <SolidColorBrush x:Key="Brush.Surface3"  Color="#FF1E2228"/>
  <SolidColorBrush x:Key="Brush.Line"      Color="#FF262A30"/>
  <SolidColorBrush x:Key="Brush.Line2"     Color="#FF343A43"/>

  <SolidColorBrush x:Key="Brush.Text1"     Color="#FFECEEF1"/>
  <SolidColorBrush x:Key="Brush.Text2"     Color="#FF9BA3AE"/>
  <SolidColorBrush x:Key="Brush.Text3"     Color="#FF6B7480"/>

  <SolidColorBrush x:Key="Brush.Lime"      Color="#FFC6F24E"/>
  <SolidColorBrush x:Key="Brush.LimeBright" Color="#D8FF6E"/>
  <SolidColorBrush x:Key="Brush.LimeDeep" Color="#A8D63C"/>
  <SolidColorBrush x:Key="Brush.LimeDim"   Color="#22C6F24E"/>
  <SolidColorBrush x:Key="Brush.LimeLine"  Color="#6BC6F24E"/>

  <SolidColorBrush x:Key="Brush.Ok"        Color="#FF35D07F"/>
  <SolidColorBrush x:Key="Brush.OkDim"     Color="#2235D07F"/>
  <SolidColorBrush x:Key="Brush.Warn"      Color="#FFE8B341"/>
  <SolidColorBrush x:Key="Brush.WarnDim"   Color="#22E8B341"/>
  <SolidColorBrush x:Key="Brush.Bad"       Color="#FFFF5F56"/>
  <SolidColorBrush x:Key="Brush.BadDim"    Color="#22FF5F56"/>
  <SolidColorBrush x:Key="Brush.Blue"      Color="#FF58A6FF"/>
</ResourceDictionary>
